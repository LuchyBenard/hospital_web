rules_version = '2';

// Providence General Hospital - Firestore security rules.
// These rules ARE the enforcement layer (skills/backend.md, RLS-style, no
// serverless). Every client goes straight to Firestore; nothing here trusts
// the client. Default is DENY: a user may only read/write their OWN data.
//
// The signed-in identity is request.auth.uid. Never soften these to let one
// patient read another patient's records.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Patient records are OWNER-SCOPED.
    // users/{uid} is the profile; everything under it belongs to that uid.
    // ------------------------------------------------------------------
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource.data.role == resource.data.role;

      function userSub(name) {
        return /databases/$(database)/documents/users/$(userId)/$(name);
      }

      match /appointments/{id} {
        allow read, write: if isOwner(userId);
      }

      match /records/{id} {
        allow read, write: if isOwner(userId);
      }

      match /prescriptions/{id} {
        allow read, write: if isOwner(userId);
      }

      match /messages/{id} {
        allow read, write: if isOwner(userId);
      }

      match /billing/{id} {
        allow read: if isOwner(userId);
      }
    }

    // ------------------------------------------------------------------
    // Public medical reference data. These drive public pages, so they are
    // readable by anyone but writable only by authenticated staff/admin.
    // ------------------------------------------------------------------
    match /departments/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /doctors/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /services/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Anonymized contact/inquiry intake (public form). Anyone may submit.
    match /inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Anything not matched above is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
